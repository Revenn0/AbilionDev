{
  "name": "abiliondev",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "npx tsx scripts/ste-flow.mts && npx tsx scripts/pipeline-flow.mts",
    "test:ui": "npx tsx scripts/ui-audit.mts",
    "typecheck": "tsc -b",
    "preview": "vite preview --host 127.0.0.1 --port 43173",
    "dev:worker": "npm run build && wrangler dev --config wrangler.staging.jsonc --var ABILION_ENV:development --port 43174",
    "deploy": "npm run deploy:staging",
    "deploy:staging": "npx tsx scripts/deploy.mts staging",
    "deploy:prod": "npx tsx scripts/deploy.mts production",
    "smoke": "npx tsx scripts/smoke.mts",
    "staging:reset": "npx tsx scripts/staging-reset.mts",
    "staging:secrets": "npx tsx scripts/staging-secrets.mts",
    "origin:rulesets": "npx tsx scripts/origin-rulesets.mts",
    "promote:check": "npx tsx scripts/promote-check.mts",
    "mcp": "npx tsx mcp/server.mts",
    "postinstall": "mkdir -p node_modules/.bin && ln -sfn ../../tools/opennext-shim/cli.mjs node_modules/.bin/opennextjs-cloudflare"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@xyflow/react": "^12.11.6",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "cobe": "^2.0.1",
    "lucide-react": "^1.47.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "puppeteer": "^24.34.0",
    "shadcn": "^4.21.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.134.0"
  }
}
