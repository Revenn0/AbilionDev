{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "abilion-staging",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "vars": {
    "SUPABASE_URL": "https://eyjgmkmaixmpmeeahxon.supabase.co",
    "APP_URL": "https://abilion-staging.vsanches1060.workers.dev",
    "ABILION_ENV": "staging"
  }
}
