{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "abilion",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "vars": {
    "SUPABASE_URL": "https://eyjgmkmaixmpmeeahxon.supabase.co",
    "APP_URL": "https://abilion.vsanches1060.workers.dev",
    "ABILION_ENV": "production"
  }
}
