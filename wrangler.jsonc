{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "abiliondev",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "routes": [
    { "pattern": "abilion.lol", "custom_domain": true },
    { "pattern": "www.abilion.lol", "custom_domain": true }
  ],
  "vars": {
    "SUPABASE_URL": "https://eyjgmkmaixmpmeeahxon.supabase.co",
    "ABILION_ENV": "production"
  }
}
